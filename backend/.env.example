# Para ejecutar la API fuera de Docker (npm run start:dev). Copiar a backend/.env.
# Apunta al MySQL de docker compose, expuesto en el host en el puerto 3307.
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ux_prueba_tecnica
DB_USER=app
DB_PASSWORD=app
DB_LOGGING=false
# Orígenes permitidos por CORS, separados por comas. Vacío = cualquiera (solo desarrollo).
# En producción: la URL del frontend, p. ej. https://gestion-ordenes.vercel.app
CORS_ORIGIN=
