# Copiar a .env y ajustar. docker compose lo lee automáticamente.
PORT=3000
API_PORT=3000

DB_HOST=localhost
# Puerto del host para MySQL en Docker; la API local se conecta a él.
DB_HOST_PORT=3307
DB_PORT=3307
DB_NAME=ux_prueba_tecnica
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DB_LOGGING=false
